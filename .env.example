PORT=3696
VITE_BASE_URL=http://localhost:3696
# Server log verbosity: trace|debug|info|warn|error|silent (default: info)
LOG_LEVEL=info

# Sentry error tracking (server-side). Leave unset to disable.
SENTRY_DSN=

# Firebase Client Config (Frontend)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin Config (Backend)
# Stringified JSON of your Service Account Key
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "...", ...}

# Persistence backend: sqlite (default, zero-setup local dev) | firestore
# staging/production always run with DB_BACKEND=firestore (set in ecosystem.config.cjs);
# set it here too if you want to test the Firestore path locally (requires
# FIREBASE_SERVICE_ACCOUNT above to point at a real project).
DB_BACKEND=sqlite

# PM2 deploy target (used by `npm run deploy:stage` / `deploy:prod` via ecosystem.config.cjs)
DEPLOY_USER=your_ssh_user
DEPLOY_HOST=your.server.host
DEPLOY_BASE_PATH=/home/your_ssh_user/hockey-scoreboard
DEPLOY_REPO=https://github.com/your_org/hockey-scoreboard.git
