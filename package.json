{
  "name": "hockey-scoreboard",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build && tsx server.ts",
    "build": "vite build",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "tsx server.ts",
    "deploy:stage": "pm2 deploy ecosystem.config.cjs staging",
    "deploy:prod": "pm2 deploy ecosystem.config.cjs production",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.18.0",
    "motion": "^13.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.13.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "ts-node": "^10.9.2",
    "vite": "^8.0.16",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/mocker": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "pm2": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ws": "^8.20.1"
  },
  "build": {
    "appId": "co.uk.brianwicks.hockey-scoreboard",
    "productName": "Hockey Scoreboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/*",
      "electron/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "dist-electron",
        "to": "server"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.sports"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
